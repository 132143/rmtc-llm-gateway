{
  "project": "rmtc-llm-gateway",
  "purpose": "RMTC 机甲大师图灵对决赛：参赛程序 + 本地 OpenAI 兼容网关 + 离线评测台",
  "version": "1.2.0",
  "date": "2026-10-28",
  "rules": "赛事规则 v1.2 + 通信协议 v1.1",
  "python_min": "3.10",
  "dependencies": {
    "third_party": [],
    "ros": [
      "rclpy",
      "std_msgs"
    ]
  },
  "entry_points": {
    "contestant": "RMTC_TEAM_TOKEN=... RMTC_AI_URL=... python3 -m contestant.bot_node --seat A --stage 2",
    "gateway": "python3 -m rmtc_gateway --port 8000",
    "tests": "python run_tests.py",
    "self_check": "python -m scripts.repo_scan && python -m scripts.stress_sweep",
    "lab": "python -m contestant.eval_lab --groups guarded_hybrid,guarded_prev --reps 6"
  },
  "contestant": [
    "__init__.py",
    "agent.py",
    "bot_node.py",
    "decision.py",
    "eval_lab.py",
    "events.py",
    "llm_replay.py",
    "map_import.py",
    "planner.py",
    "run_experiments.py",
    "sim.py",
    "stage2_sim.py",
    "strategy.py",
    "sweeper.py",
    "tactics.py"
  ],
  "rmtc_client": [
    "__init__.py",
    "event_understanding.py",
    "json_extract.py",
    "llm_client.py"
  ],
  "rmtc_gateway": [
    "__init__.py",
    "__main__.py",
    "config.py",
    "errors.py",
    "limits.py",
    "server.py",
    "upstream.py"
  ],
  "scripts": [
    "analyze_lab.py",
    "gen_maps.py",
    "gen_stage2.py",
    "loss_report.py",
    "map_tool.py",
    "package.py",
    "record_llm_hints.py",
    "repo_scan.py",
    "rescore.py",
    "stress_sweep.py"
  ],
  "sealed": "见 SEALED_VERSION.txt（commit / tag / 质量门 / 一键回滚）",
  "quality_gates": {
    "tests": 247,
    "repo_scan": "5 项 OK",
    "stress_sweep": "OK"
  }
}
